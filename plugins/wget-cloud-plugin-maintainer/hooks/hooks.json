{
  "description": "Approval, path-isolation, role-ledger, and delivery gates for Wget Cloud Codex plugin maintenance.",
  "hooks": {
    "SessionStart": [{ "matcher": "startup|resume|clear|compact", "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/maintainer_hooks.py\" session-start", "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\maintainer_hooks.py\" session-start", "timeout": 5, "statusMessage": "Loading plugin maintenance boundaries", "additionalContextLimit": 1400 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/maintainer_hooks.py\" prompt-submit", "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\maintainer_hooks.py\" prompt-submit", "timeout": 5, "statusMessage": "Checking plugin maintenance approval", "additionalContextLimit": 1400 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/maintainer_hooks.py\" subagent-start", "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\maintainer_hooks.py\" subagent-start", "timeout": 5, "statusMessage": "Loading maintainer role contract", "additionalContextLimit": 1200 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/maintainer_hooks.py\" subagent-stop", "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\maintainer_hooks.py\" subagent-stop", "timeout": 5, "statusMessage": "Recording maintainer role verdict" }] }],
    "PreToolUse": [{ "matcher": "^(Bash|apply_patch|Edit|Write)$", "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/maintainer_hooks.py\" pre-tool", "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\maintainer_hooks.py\" pre-tool", "timeout": 8, "statusMessage": "Enforcing plugin maintenance scope", "additionalContextLimit": 1200 }] }],
    "PostToolUse": [{ "matcher": "^(Bash|apply_patch|Edit|Write)$", "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/maintainer_hooks.py\" post-tool", "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\maintainer_hooks.py\" post-tool", "timeout": 8, "statusMessage": "Tracking approved plugin maintenance", "additionalContextLimit": 1000 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/maintainer_hooks.py\" stop", "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\maintainer_hooks.py\" stop", "timeout": 8, "statusMessage": "Registering plugin maintenance gate" }] }],
    "SessionEnd": [{ "matcher": "other", "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/maintainer_hooks.py\" session-end", "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\maintainer_hooks.py\" session-end", "timeout": 3, "statusMessage": "Closing plugin maintenance approvals" }] }]
  }
}
