{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized WGC external delivery evidence",
  "type": "object",
  "required": ["commit", "workflow", "status", "observed_at", "source"],
  "additionalProperties": false,
  "properties": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workflow": {"const": "validate"},
    "status": {"const": "success"},
    "observed_at": {"type": "integer", "minimum": 0},
    "source": {"const": "github"},
    "subject_task_id": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "required": ["plugin", "version", "status", "enabled"],
      "additionalProperties": false,
      "properties": {
        "plugin": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["installed", "cache-only", "absent", "version-mismatch"]},
        "enabled": {"type": "boolean"}
      }
    },
    "smoke": {
      "type": "object",
      "required": ["task_id", "commit", "status", "source", "observed_at"],
      "additionalProperties": false,
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "status": {"const": "success"},
        "source": {"const": "codex"},
        "observed_at": {"type": "integer", "minimum": 0}
      }
    }
  }
}
