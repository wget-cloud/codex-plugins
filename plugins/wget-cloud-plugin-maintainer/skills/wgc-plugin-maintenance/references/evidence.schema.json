{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized WGC external delivery evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["commit", "workflow", "status", "observed_at", "source"],
  "properties": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "maxLength": 40},
    "workflow": {"const": "validate"}, "status": {"const": "success"},
    "observed_at": {"type": "integer", "minimum": 0}, "source": {"const": "github"},
    "subject_task_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["plugin", "version", "status", "enabled"], "properties": {"plugin": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"}, "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"}, "status": {"const": "installed"}, "enabled": {"const": true}}},
    "smoke": {"type": "object", "additionalProperties": false, "required": ["task_id", "plugin", "version", "commit", "status", "source", "observed_at"], "properties": {"task_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"}, "plugin": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"}, "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "status": {"const": "success"}, "source": {"const": "codex"}, "observed_at": {"type": "integer", "minimum": 0}}}
  }
}
